{
  "id": "pve-power",
  "name": "Proxmox Power",
  "version": "0.8.2",
  "description": "Start Proxmox VMs and LXC containers on demand and shut them down after idle CPU use or a time limit.",
  "author": {
    "name": "jeakob",
    "url": "https://github.com/jeakob"
  },
  "license": "MIT",
  "category": "Infrastructure",
  "icon": "Power",
  "features": [
    "Start or gracefully stop a Proxmox VM or LXC container",
    "Start a linked guest from its host action before connecting",
    "Graceful shutdown after sustained idle CPU use or maximum uptime"
  ],
  "engine": {
    "termix": ">=26.11.1",
    "api": "^2.1"
  },
  "capabilities": [
    "files:own",
    "network:serve",
    "hosts:read",
    "ssh:connect",
    "credentials:use",
    "users:impersonate",
    "ui:surface"
  ],
  "contributes": {
    "mobile": {
      "mode": "webview",
      "views": [
        "pve-power",
        "Proxmox-Power-Controls"
      ]
    },
    "tabs": [
      {
        "id": "pve-power",
        "titleKey": "tab.title",
        "icon": "Power",
        "openFrom": [
          "rail"
        ]
      },
      {
        "id": "pve-power-connect",
        "titleKey": "hostAction.title",
        "icon": "PlugZap",
        "openFrom": [
          "host-context-menu"
        ]
      },
      {
        "id": "Proxmox-Power-Controls",
        "titleKey": "hostAction.controls",
        "icon": "Power",
        "openFrom": [
          "host-context-menu"
        ]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": [
          "admin"
        ]
      },
      {
        "name": "manage",
        "titleKey": "permissions.manage.title",
        "descriptionKey": "permissions.manage.description",
        "defaultRoles": [
          "admin"
        ]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enabled",
        "enableLabelKey": "settings.host.enabled.label",
        "fields": []
      },
      "user": [
        {
          "key": "showControls",
          "type": "boolean",
          "labelKey": "settings.user.showControls.label",
          "descriptionKey": "settings.user.showControls.description",
          "default": true
        },
        {
          "key": "showConnect",
          "type": "boolean",
          "labelKey": "settings.user.showConnect.label",
          "descriptionKey": "settings.user.showConnect.description",
          "default": true
        },
        {
          "key": "showStart",
          "type": "boolean",
          "labelKey": "settings.user.showStart.label",
          "descriptionKey": "settings.user.showStart.description",
          "default": true
        },
        {
          "key": "showStop",
          "type": "boolean",
          "labelKey": "settings.user.showStop.label",
          "descriptionKey": "settings.user.showStop.description",
          "default": true
        }
      ]
    }
  },
  "locales": "locales",
  "repository": "https://github.com/jeakob/termix-plugin-pve-power",
  "docs": "https://github.com/jeakob/termix-plugin-pve-power/blob/main/docs/index.md",
  "sandbox": {
    "schedules": [
      {
        "id": "poll",
        "every": 60000
      }
    ]
  }
}
